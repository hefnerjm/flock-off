{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flockoff.org/schemas/abuse-case.schema.json",
  "title": "AbuseCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "date",
    "location",
    "actor",
    "category",
    "summary",
    "sources",
    "verified",
    "addedBy",
    "addedDate"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Slug matching the filename (without .json)"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the incident occurred (not the date it was reported, if different)"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "city": { "type": "string" },
        "county": { "type": "string" },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "description": "USPS two-letter state code"
        },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "agency": {
      "type": "string",
      "description": "Agency implicated, as named by the cited source(s)"
    },
    "actor": {
      "type": "string",
      "description": "Who is reported to have done this, as stated by the source. Use a role/title (e.g. \"a sheriff's deputy\") unless the source names an individual."
    },
    "category": {
      "type": "string",
      "enum": [
        "stalking",
        "immigration",
        "reproductive",
        "protest-1a",
        "data-sharing",
        "warrantless-dragnet",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2000,
      "description": "What happened, attributed to its source (e.g. \"According to a 404 Media investigation...\"). Use \"alleged\" for anything not adjudicated."
    },
    "outcome": {
      "type": "string",
      "description": "What happened as a result (discipline, charges, litigation, policy change, or \"none reported\")"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "outlet", "date"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "outlet": { "type": "string" },
          "date": { "type": "string", "format": "date" }
        }
      }
    },
    "verified": {
      "type": "boolean",
      "description": "Whether a maintainer has confirmed the source(s) support the summary as written"
    },
    "addedBy": { "type": "string" },
    "addedDate": { "type": "string", "format": "date" }
  }
}

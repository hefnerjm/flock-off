---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="prose">
    <slot />
  </article>
</BaseLayout>

<style>
  .prose {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    line-height: 1.7;
  }

  .prose :global(h1) {
    margin-top: 0;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-accent, #ff3b30);
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseTableIsland from "../../components/CaseTableIsland.tsx";
import { loadAbuseCases } from "../../utils/loadData";

const cases = loadAbuseCases().map((c) => ({
  id: c.id,
  title: c.title,
  date: c.date,
  city: c.location.city,
  state: c.location.state,
  category: c.category,
  agency: c.agency,
}));
---

<BaseLayout title="Abuse Database" description="Searchable database of documented Flock Safety ALPR camera abuse and warrantless surveillance cases.">
  <section class="page-header">
    <h1>Abuse Database</h1>
    <p>
      Every case requires at least one working source. See the{" "}
      <a href="/methodology">methodology</a> for what counts as a case, or{" "}
      <a href="/database/submit">submit a case</a> we're missing.
    </p>
  </section>

  <CaseTableIsland client:load cases={cases} />
</BaseLayout>

<style>
  .page-header {
    padding: 2rem 1.5rem 1rem;
  }

  :global(.case-table) {
    padding: 0 1.5rem 3rem;
  }

  :global(.table-controls) {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: flex-end;
    margin-bottom: 1.5rem;
  }

  :global(.search-label input) {
    min-width: 280px;
  }

  :global(.case-table table) {
    width: 100%;
    border-collapse: collapse;
  }

  :global(.case-table th),
  :global(.case-table td) {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid rgba(232, 232, 232, 0.15);
  }

  :global(.case-table th button) {
    background: none;
    border: none;
    color: inherit;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
  }
</style>

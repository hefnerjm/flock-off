---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout title={site.name} description={site.tagline}>
  <section class="hero">
    <h1>{site.name}</h1>
    <p>{site.tagline}</p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 1.5rem;
    text-align: center;
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterBar from "../../components/FilterBar.tsx";
import { loadLegalCases } from "../../utils/loadData";

const cases = loadLegalCases().map((c) => ({
  id: c.id,
  caseName: c.caseName,
  court: c.court,
  status: c.status,
  issue: c.issue,
  whyItMatters: c.whyItMatters,
}));
---

<BaseLayout title="Legal Tracker" description="Filterable tracker of lawsuits and legal challenges to Flock Safety ALPR surveillance.">
  <section class="page-header">
    <h1>Legal Tracker</h1>
    <p>
      Every lawsuit and legal challenge we're tracking related to ALPR
      surveillance and data sharing. See the{" "}
      <a href="/legal/state-of-the-law">state of the law</a> for background
      on the doctrinal shift these cases are building on.
    </p>
  </section>

  <FilterBar client:load cases={cases} />
</BaseLayout>

<style>
  .page-header {
    padding: 2rem 1.5rem 1rem;
  }

  :global(.legal-filter) {
    padding: 0 1.5rem 3rem;
  }

  :global(.filter-controls) {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  :global(.filter-controls label) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }

  :global(.case-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.case-card) {
    border: 1px solid rgba(232, 232, 232, 0.2);
    border-radius: 8px;
    padding: 1.25rem;
  }

  :global(.case-card h2) {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
  }

  :global(.case-meta) {
    font-size: 0.85rem;
    opacity: 0.75;
    margin: 0 0 0.5rem;
  }
</style>

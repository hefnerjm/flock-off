---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapIsland from "../components/MapIsland.tsx";
import { loadAbuseCases, loadWins } from "../utils/loadData";

const abuseIncidents = loadAbuseCases()
  .filter((c) => typeof c.location.lat === "number" && typeof c.location.lng === "number")
  .map((c) => ({
    id: c.id,
    title: c.title,
    agency: c.agency,
    actor: c.actor,
    summary: c.summary,
    outcome: c.outcome,
    category: c.category,
    sources: c.sources,
    lat: c.location.lat as number,
    lng: c.location.lng as number,
  }));

const wins = loadWins()
  .filter((w) => typeof w.lat === "number" && typeof w.lng === "number")
  .map((w) => ({
    id: w.id,
    city: w.city,
    state: w.state,
    date: w.date,
    sourceUrl: w.sourceUrl,
    lat: w.lat as number,
    lng: w.lng as number,
  }));
---

<BaseLayout title="Camera Map" description="Interactive map of Flock Safety ALPR camera locations, documented abuse incidents, and cities that canceled Flock contracts.">
  <Fragment slot="head">
    <link rel="preconnect" href="https://tile.openstreetmap.org" />
    <link rel="preconnect" href="https://a.tile.openstreetmap.org" />
    <link rel="preconnect" href="https://b.tile.openstreetmap.org" />
    <link rel="preconnect" href="https://c.tile.openstreetmap.org" />
  </Fragment>
  <section class="page-header">
    <h1>Camera Map</h1>
    <p>
      Camera locations come only from crowdsourced OpenStreetMap data — never
      invented. See the <a href="/methodology">methodology page</a> for how
      this map is built.
    </p>
  </section>

  <div class="map-shell">
    <MapIsland client:only="preact" abuseIncidents={abuseIncidents} wins={wins} defaultPreset="bexar" />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 2rem 1.5rem 1rem;
  }

  /* client:only renders nothing server-side, so without this the footer
     jumps up ~200px on first paint and jumps back down once the island
     mounts - reserving roughly the final rendered height here (measured
     via Lighthouse CLS culprit trace) avoids that shift entirely. */
  .map-shell {
    min-height: calc(70vh + 160px);
  }

  :global(.map-island) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0 1.5rem 2rem;
  }

  :global(.map-controls),
  :global(.map-layers) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  :global(.preset-btn) {
    background: transparent;
    border: 1px solid var(--color-fg, #e8e8e8);
    color: var(--color-fg, #e8e8e8);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
  }

  :global(.preset-btn.active) {
    background: var(--color-accent-contrast, #c62828);
    border-color: var(--color-accent-contrast, #c62828);
    color: #fff;
  }

  :global(.map-layers label) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  :global(.map-canvas) {
    width: 100%;
    height: 70vh;
    min-height: 400px;
    border-radius: 8px;
    overflow: hidden;
  }

  :global(.map-attribution) {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  :global(.map-error) {
    color: var(--color-accent, #ff3b30);
  }

  :global(.cluster-count-label) {
    background: transparent;
    border: none;
    box-shadow: none;
    color: #fff;
    font-weight: 700;
    font-size: 0.75rem;
  }
</style>

---
interface Props {
  text?: string;
}

const {
  text = "This page is for public education only and is not legal advice. Laws and case status change; consult a licensed attorney about your specific situation.",
} = Astro.props;
---

<aside class="disclaimer" role="note">
  <p>{text}</p>
</aside>

<style>
  .disclaimer {
    border: 1px solid var(--color-accent, #ff3b30);
    border-radius: 6px;
    padding: 0.9rem 1.1rem;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .disclaimer p {
    margin: 0;
  }
</style>
